# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.8-flash

# PostgreSQL Database
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/ai_worker

# Browser Automation
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOWMO_MS=300

# Sandbox Portal URLs
INVOICE_PORTAL_URL=http://localhost:8000/sandbox/invoice-portal
BILLING_PORTAL_URL=http://localhost:8000/sandbox/billing-portal

# Application Settings
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
EVIDENCE_DIR=./evidence
MAX_RETRIES=2