# LLM Configuration
# Set LLM_PROVIDER to 'gemini' (recommended) or 'openai'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-flash-latest

# OpenAI (alternative — only required if LLM_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
# Uses Neon PostgreSQL in production. Example:
# DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require
# Local SQLite fallback:
DATABASE_URL=sqlite:///./app.db

# Browser Automation (Playwright)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOWMO_MS=300

# Sandbox Portal URLs
# In local development, both portals are served by the same FastAPI process:
INVOICE_PORTAL_URL=http://localhost:8000/sandbox/invoice-portal
BILLING_PORTAL_URL=http://localhost:8000/sandbox/billing-portal
# In production on Render, replace localhost with your Render backend URL:
# INVOICE_PORTAL_URL=https://your-backend.onrender.com/sandbox/invoice-portal
# BILLING_PORTAL_URL=https://your-backend.onrender.com/sandbox/billing-portal

# Application Settings
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
EVIDENCE_DIR=./evidence
MAX_RETRIES=2
